{
  "config": {
    "default": true,
    "MD013": false, // Line length disabled for command lines and technical blocks
    "MD024": { "siblings_only": true }, // Multiple headers with same content allowed in different sections
    "MD033": false, // Inline HTML allowed for badges, keyboard keys, and details tags
    "MD041": false  // First line in file does not need to be top-level heading if frontmatter or title block
  },
  "globs": [
    "docs/**/*.md",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "ignores": [
    "site/**",
    "node_modules/**"
  ]
}
